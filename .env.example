# No credentials needed for demo. Copy to .env for live mode or overrides.
APP_MODE=demo
APP_URL=http://localhost:3000
# Demo uses a local embedded PostgreSQL database; one Next process only.
DEMO_DATA_DIR=.data/demo
# Required for live. Ignored in demo to prevent accidental live-data exposure.
DATABASE_URL=
# Live web process: false. Run pnpm worker separately. Demo defaults to true.
EMBEDDED_WORKER=
# Required for live. Generate independent random values; never reuse provider secrets.
ADMIN_PASSWORD=
SESSION_SECRET=
# Exactly 32 random bytes, base64 encoded: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact redirect URI in Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connections/gmail/callback
# Approved mailbox identity; required before starting the app's Gmail OAuth flow.
GMAIL_EXPECTED_MAILBOX=
# Safe default for interview validation. Never set mailbox for an account with private mail.
GMAIL_DATA_SCOPE=seed-only
# Private receipt from the approved live seeder; missing/invalid receipts block ingestion.
GMAIL_SEED_MANIFEST_PATH=.data/live-seed/manifest.json
# Additional owned lender aliases, comma-separated. Primary mailbox is discovered via Gmail.
LENDER_ALIASES=
# Connect via the server-only admin form. Optional bootstrap token for headless setup.
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_SPONSOR_PROPERTY=contact_type
HUBSPOT_SPONSOR_VALUE=Sponsor
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
