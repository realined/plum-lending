{
  "name": "plum-lending-segments",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "sample": "tsx scripts/sample.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "setup:live": "tsx scripts/prepare-live.ts",
    "config:check": "tsx --env-file=.env scripts/check-config.ts",
    "format": "prettier --write src tests e2e scripts *.ts *.mjs",
    "package:source": "python3 scripts/package-source.py",
    "test:api": "playwright test e2e/api.spec.ts",
    "test:postgres": "tsx scripts/verify-postgres.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.46.0",
    "mailparser": "^3.9.28",
    "next": "^16.3.5",
    "openai": "^7.15.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  }
}
